#include<bits/stdc++.h>
using namespace std;

void bubble(int arr[], int len){
    
    for(int i = 0; i<len-1;i++){
        for(int j = 0; j<len-i-1;j++){
            if(arr[j]>arr[j+1]){
                swap(arr[j],arr[j+1]);
            }
        }
    }
}

void selection(int arr[] , int len){
    
    for(int i = 0; i<len-1;i++){
        int small = i;
        for (int j = i+1; j<len;j++){
            if(arr[j]<arr[small]){
                small = j;
            }
        }
        
        swap(arr[i] , arr[small]);
    }
}


void insertion(int arr[] , int len){
    
    for(int i = 1; i<len;i++){
        int curr = arr[i];
        int prev = i-1;
        
        while(prev >= 0 && arr[prev]>curr){
            arr[prev+1] = arr[prev];
            prev--;
        }
        
        arr[prev+1] = curr;
    }
}

void print(int arr[], int len){
    
    for(int i=0; i<len;i++){
        cout << arr[i] << " ";
    }
    cout<<endl;
}

int main(){
    int n = 5;
    int a[] = {4,3,5,2,6};
    print(a,n);
    insertion(a,n);
    print(a,n);
    return 0;
}
